# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=dwigo
DB_PASSWORD=your_postgres_password_here
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# JWT Secret (for authentication)
# Generate a random string for production: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin API Token (for admin ingestion review)
# Generate a random string for production: openssl rand -base64 32
ADMIN_API_TOKEN=your-admin-token-here-change-this

# Server Port
PORT=3001

# Frontend URL (for password reset link in emails; defaults to first CORS origin or localhost)
# FRONTEND_URL=https://dwigo.vercel.app

# Enable Scheduler (set to 'true' to enable cron jobs in API process)
ENABLE_SCHEDULER=false

# Job Worker Concurrency (number of concurrent BullMQ workers)
JOB_WORKER_CONCURRENCY=5

# Rate limit: max requests per 15-minute window per IP (default 400)
# RATE_LIMIT_MAX=400

# --- Real deal ingestion (pick at least one) ---
# Eventbrite: private token from https://www.eventbrite.com/platform/api/
# Public GET /v3/events/search/ was removed by Eventbrite (404). This app uses:
#   GET /v3/users/me/owned_events/  and optional  GET /v3/organizations/{id}/events/
# Then: cd server && npm run ingest:eventbrite  (or POST /api/admin/ai/fetch-eventbrite)
EVENTBRITE_API_TOKEN=
# Comma-separated org IDs you manage (optional, for more than "my" events)
# EVENTBRITE_ORGANIZATION_IDS=
# Set to true to drop events whose venue is outside ~120km of Mid-Michigan centers
# EVENTBRITE_GEO_FILTER=false

# Google Places (Text Search + Details for admin "Discover Dining (Places → websites)";
# merchant validation elsewhere). Official API does NOT return GBP posts/offers for arbitrary businesses.
GOOGLE_PLACES_API_KEY=
# Default geographic bias when admin omits both `cities` and `nearText` (keep small). Prefer API body:
#   { "cities": ["Flint","Grand Blanc","Fenton"], "maxPlaces": 14, "queryRotationLimit": 5 }
# PLACES_DINING_NEAR_TEXT=Lansing Flint Grand Blanc Michigan
# Discover Dining: async job (202 + poll GET .../discover-dining-scrape/job/:id). Sync: POST {"wait":true} (scripts only).
# AI Real (/admin/ai/fetch-deals): same async + poll GET .../fetch-deals/job/:id; sync with {"wait":true}.

# Optional: load consumer Google Maps page per place_id with Playwright and feed visible text to the LLM
# (best-effort; slower per venue; Maps may block bots; review Google Maps Terms of Service).
# Discover Dining merges any extracted deal with website scrape. Set "true" to try (needs Playwright + extraction API key).
ENABLE_GBP_MAPS_SCRAPE=false

# Optional: AI discovery & scraper enrichment
# OPENAI_API_KEY=
# Optional: use Claude for deal extraction (scrapers / real AI path) instead of OpenAI
# EXTRACTION_USE_CLAUDE=false
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Larger HTML snippet sent to extraction LLM (default 12000)
# EXTRACTION_HTML_MAX_CHARS=12000

# Web scraper (dealSources.json): restrict to one vertical for POC, e.g. only Dining venues
# SCRAPER_CATEGORY_FILTER=Dining

# Optional: reject ingested rows when Places can’t verify merchant (stricter pipeline)
# ENABLE_MERCHANT_VALIDATION=false

# Deal Quality Thresholds (0.0 to 1.0)
# MIN_DEAL_QUALITY_SCORE: Minimum quality score for promotion (default: 0.4 = 40%)
# AUTO_REJECT_QUALITY_SCORE: Auto-reject deals below this score (default: 0.25 = 25%)
MIN_DEAL_QUALITY_SCORE=0.4
AUTO_REJECT_QUALITY_SCORE=0.25
